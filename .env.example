# Copy this file to .env and fill in your keys.
# Get Apify key:  https://console.apify.com/settings/integrations
# Get Groq key:   https://console.groq.com/keys

APIFY_API_KEY=your_apify_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Which Apify actor to use for scraping
# curious_coder/linkedin-jobs-scraper is the most reliable (pay-per-event, $1/1000 jobs)
APIFY_ACTOR=curious_coder/linkedin-jobs-scraper

# Groq model (any model listed at https://console.groq.com/models)
# allam-2-7b has a 4096-token window; the parsers' lean schemas are tuned for it
GROQ_MODEL=allam-2-7b